# SORI v0.1: input has a schema, each route has an explicit auth policy.
app "SORI Secure API"

# The only public endpoint, suitable for container health probes.
route GET "/health" public:
  return {"status": "ok", "framework": "SORI v0.1"}

route POST "/greet" protected:
  input name: str(1, 80)
  return {"message": "안녕하세요, " + input.name}

route POST "/add" protected:
  input a: int(-1000, 1000)
  input b: int(-1000, 1000)
  return {"result": input.a + input.b}

# A separately deployed, explicitly addressed Python/ROS/ML worker.
# Only loopback transport is accepted in v0.1. The bundled worker is a
# deterministic sample, NOT a production AI model.
worker "risk-model" "http://127.0.0.1:9010/invoke" timeout 1200

route POST "/risk" protected:
  input signal: float(0, 1)
  invoke "risk-model"
