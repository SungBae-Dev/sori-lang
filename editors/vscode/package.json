{
  "name": "sori-language",
  "displayName": "SORI Language (experimental)",
  "description": "Syntax highlighting for SORI (.sori): unified language v0.3 and the v0.1 declarative API DSL",
  "version": "0.3.0-alpha.1",
  "publisher": "sori-community",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sori",
        "aliases": [
          "SORI"
        ],
        "extensions": [
          ".sori"
        ]
      }
    ],
    "grammars": [
      {
        "language": "sori",
        "scopeName": "source.sori",
        "path": "./syntaxes/sori.tmLanguage.json"
      }
    ]
  }
}
